import random
import string

def gerar_senha_forte(tamanho=12):
    maiusculas = string.ascii_uppercase
    minusculas = string.ascii_lowercase
    numeros = string.digits
    simbolos = "!@#$%&*?_-"
    
    senha = [
        random.choice(maiusculas),
        random.choice(minusculas),
        random.choice(numeros),
        random.choice(simbolos)
    ]
    
    todos_caracteres = maiusculas + minusculas + numeros + simbolos
    for _ in range(tamanho - 4):
        senha.append(random.choice(todos_caracteres))
        
    random.shuffle(senha)
    return "".join(senha)

print("--- BEM-VINDO AO GERADOR DE SENHAS FORTES ---")

while True:

    try:
        tamanho_usuario = int(input("\nDigite o tamanho desejado para a senha (mínimo 4): "))
        if tamanho_usuario < 4:
            print("O tamanho mínimo recomendado para uma senha forte é 4. Usando tamanho 4.")
            tamanho_usuario = 4
    except ValueError:
        print("Valor inválido! Usando o tamanho padrão de 12 caracteres.")
        tamanho_usuario = 12

    # Gera e exibe a senha
    senha_gerada = gerar_senha_forte(tamanho_usuario)
    print(f" Senha gerada: {senha_gerada}")


    continuar = input("\nDeseja gerar outra senha? (s/n): ").strip().lower()
    
    if continuar != 's':
        print("\nEncerrando o gerador de senhas.")
        break
